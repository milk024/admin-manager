PORT=8100
ALLOWED_ORIGINS=

# admin-manager 전용 논리 DB — k8s_manager가 쓰는 Gitea Postgres 인스턴스를 그대로 재사용하되
# DB/계정은 완전히 분리한다 (권한 격리 목적, ADR 예정).
PGHOST=gitea-postgresql.infra.svc.cluster.local
PGPORT=5432
PGDATABASE=admin_manager
PGUSER=admin_manager
PGPASSWORD=

# JWT 서명 키 — 반드시 별도로 발급, 커밋 금지.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# 최초 관리자 계정 부트스트랩 — admin_users 테이블이 비어있을 때만 1회 생성됨.
# 값을 채워서 처음 기동한 뒤에는 비워도 되고, 남겨둬도 이후 기동에는 영향 없음(테이블에 이미 있으면 스킵).
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# 발급 kubeconfig 의 API 서버 주소 (개발자 PC 에서 닿는 주소). 비우면 현재 클러스터 주소(in-cluster 면 10.96.0.1 → 외부에서 못 씀)
K8S_PUBLIC_API_SERVER=https://10.0.0.20:6443
# 계정 발급 가능한 네임스페이스 (쉼표 구분, 배포 차트 rbac.namespaces 와 동일하게)
ISSUABLE_NAMESPACES=rag-system,vkey-system

# 클러스터 밖 로컬 개발 시 폴백 (in-cluster 배포 시엔 ServiceAccount 자동 인증, k8s_manager와 동일 패턴)
KUBECONFIG=

# Gitea 사용자·팀 관리 (gitea-mgmt-svc 토큰)
GITEA_BASE_URL=
GITEA_MGMT_TOKEN=
GITEA_ORG=myorg
GITEA_PROTECTED_TEAMS=Owners,ci-*,svc-*
